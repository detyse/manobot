{
  "$schema": "https://raw.githubusercontent.com/HKUDS/nanobot/main/schema.json",
  "agents": {
    "defaults": {
      "workspace": "~/.manobot/workspace",
      "model": "anthropic/claude-sonnet-4-20250514",
      "provider": "auto",
      "maxTokens": 8192,
      "temperature": 0.1,
      "maxToolIterations": 40,
      "memoryWindow": 100
    },
    "list": [
      {
        "id": "assistant",
        "default": true,
        "name": "Main Assistant",
        "identity": {
          "name": "Nano",
          "description": "A helpful AI assistant for general tasks"
        },
        "channels": {
          "sendProgress": true,
          "telegram": {
            "enabled": true,
            "token": "YOUR_ASSISTANT_TELEGRAM_BOT_TOKEN",
            "allowFrom": []
          }
        }
      },
      {
        "id": "coder",
        "name": "Code Assistant",
        "workspace": "~/projects",
        "model": "deepseek/deepseek-coder",
        "skills": ["coding", "git", "shell"],
        "identity": {
          "name": "CodeBot",
          "description": "Specialized coding assistant"
        },
        "subagents": {
          "allowAgents": ["reviewer"],
          "model": "deepseek/deepseek-chat"
        },
        "channels": {
          "sendProgress": true,
          "telegram": {
            "enabled": true,
            "token": "YOUR_CODER_TELEGRAM_BOT_TOKEN",
            "allowFrom": []
          },
          "discord": {
            "enabled": true,
            "token": "YOUR_CODER_DISCORD_BOT_TOKEN",
            "allowFrom": []
          }
        }
      },
      {
        "id": "reviewer",
        "name": "Code Reviewer",
        "model": "anthropic/claude-sonnet-4-20250514",
        "skills": ["coding"],
        "identity": {
          "name": "Reviewer",
          "description": "Code review specialist"
        },
        "channels": {
          "slack": {
            "enabled": true,
            "botToken": "xoxb-REVIEWER-BOT-TOKEN",
            "appToken": "xapp-REVIEWER-APP-TOKEN"
          }
        }
      }
    ]
  },
  "channels": {
    "sendProgress": true,
    "sendToolHints": false
  },
  "providers": {
    "anthropic": {
      "apiKey": "YOUR_ANTHROPIC_API_KEY"
    },
    "deepseek": {
      "apiKey": "YOUR_DEEPSEEK_API_KEY"
    },
    "openrouter": {
      "apiKey": "YOUR_OPENROUTER_API_KEY"
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800
    }
  },
  "tools": {
    "web": {
      "proxy": null,
      "search": {
        "apiKey": "",
        "maxResults": 5
      }
    },
    "exec": {
      "timeout": 60,
      "pathAppend": ""
    },
    "restrictToWorkspace": false,
    "mcpServers": {}
  }
}
